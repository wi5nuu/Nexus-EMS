PORT=7860
NODE_ENV=production
JWT_SECRET=nexus_ems_super_secret_123

# Database (From Supabase -> Settings -> Database -> Connection String -> URI)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:CHANGE_ME@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres"

# Redis (From Upstash -> Details -> Endpoint)
# Format: rediss://default:[TOKEN]@[YOUR_REDIS_ENDPOINT]:6379
REDIS_URL="rediss://default:CHANGE_ME@YOUR_REDIS_ENDPOINT:6379"

# Kafka (Optional)
KAFKA_BROKERS="localhost:9092"
